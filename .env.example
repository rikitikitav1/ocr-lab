# OpenAI-compatible providers for the stand's own model steps; ollama needs no key
MODEL_CLOUD_BASE_URL=https://api.deepseek.com
MODEL_CLOUD_API_KEY=
CPU_LANE_THREADS=4
# the lanes a worker serves: cpu,gpu for one worker doing both; gpu for the card's single worker, cpu for the rest
WORKER_LANES=cpu,gpu
